rules_version = '2';

// Ragnarök TTRPG portal — Firestore security rules.
//
// Security model:
//   * The site is served behind Cloudflare Access — the actual gate that
//     decides WHO can reach the app lives at the Cloudflare layer.
//   * The web app signs in with Firebase Anonymous Auth, so every legitimate
//     request carries `request.auth`. These rules therefore require an
//     authenticated session and deny all unauthenticated traffic, while
//     leaving per-role (GM vs player) checks to the application layer.
//   * All app data lives under `campaigns/{campaignId}/...`. Anything outside
//     that tree is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // Campaign tree: the single container for every collection the app uses
    // (boards, characters, config, inventory, inventoryGm, spotlight,
    //  spotlightSessions, codex, library). A signed-in session may read and
    // write anywhere inside a campaign.
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny: nothing outside the campaign tree is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
